{
  "expo": {
    "name": "Hiro",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-web-browser",
      "expo-notifications"
    ],
    "slug": "hiro",
    "version": "0.1.3",
    "scheme": "hiro",
    "newArchEnabled": false,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "justins9269s-team",
    "ios": {
      "bundleIdentifier": "com.behiro.app",
      "associatedDomains": [
        "applinks:hiro.example.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.behiro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15121f"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hiro.example.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "b732bece-946b-4fc7-8407-7088f6ef4873"
      }
    }
  }
}
